# Supabase. La app corre sin esto: por defecto usa el repositorio local
# con los datos de ejemplo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Formas de entrar habilitadas, separadas por coma: google, apple, telefono.
# Vacío = sólo mail. Cada una hay que configurarla en Supabase primero:
# Google necesita un cliente OAuth, Apple una cuenta de desarrollador
# (US$ 99 por año) y el teléfono un proveedor de SMS que cobra por mensaje.
VITE_AUTH_PROVIDERS=
